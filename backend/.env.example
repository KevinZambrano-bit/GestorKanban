DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=

# JWT
JWT_SECRET=
JWT_EXPIRES=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GOOGLE_CALLBACK_URL=

# URL del frontend para CORS, redirect de Google y enlaces de invitación
# y recuperación de contraseña (separar varias con coma)
FRONTEND_URL=http://localhost:5173

# Límite de peticiones por IP para toda la API (protección de fuerza bruta)
THROTTLE_LIMIT=120
THROTTLE_TTL_MS=60000

# Correos transaccionales (Gmail SMTP vía Nodemailer)
# Requiere una cuenta Google con la verificación en dos pasos activa y una
# contraseña de aplicación creada en https://myaccount.google.com/apppasswords
# (no sirve la contraseña normal de la cuenta). Sin estas variables el proyecto
# arranca igual, pero no se envía ningún correo.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Nombre visible del remitente. La dirección siempre es GMAIL_USER: Gmail no
# admite enviar en nombre de otro dominio sin configurarlo previamente.
MAIL_FROM_NAME=GestorKanban

# Dominios de correo desechable extra a bloquear en las invitaciones, separados
# por coma. Los más comunes (mailinator, yopmail, ...) ya vienen en el código.
# MAIL_BLOCKED_DOMAINS=midominio-temporal.com,otro-desechable.com
